# =====================================================
# RECRUITIFY — Environment Variables Template
# =====================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# =====================================================

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-32-char-random-hex-secret-here
JWT_SECRET_KEY=your-different-32-char-random-hex-here

# Local dev: leave empty (uses SQLite). Production: postgresql://user:pass@host:5432/db
DATABASE_URL=

CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
REDIS_URL=redis://127.0.0.1:6379/0

MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=your-email@gmail.com
MAIL_SMTP_PASSWORD=your-16-char-app-password-here
MAIL_SMTP_USE_TLS=true
MAIL_SMTP_USE_SSL=false
MAIL_SIMULATE_WHEN_UNCONFIGURED=false

JOBS_REMINDER_CHANNELS=email
JOBS_REPORT_OUTPUT_DIR=reports
JOBS_MONTHLY_REPORT_AUDIENCE=admin
JOBS_MONTHLY_REPORT_FORMAT=both
JOBS_TEST_MODE=true
JOBS_DISABLE_IDEMPOTENCY=true

ALLOWED_ORIGINS=http://localhost:5173

# Cloudinary (resume storage) — get from cloudinary.com/console
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name